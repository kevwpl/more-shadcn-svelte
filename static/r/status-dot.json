{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "status-dot",
	"title": "Status Dot",
	"type": "registry:ui",
	"description": "A simple indicator for state, presence, or activity.",
	"devDependencies": [
		"tailwind-variants@^3.1.1"
	],
	"files": [
		{
			"content": "<script lang=\"ts\">\r\n\timport { cn } from '$UTILS$.js';\r\n\timport { tv, type VariantProps } from 'tailwind-variants';\r\n\r\n\tconst dotVariants = tv({\r\n\t\tbase: 'rounded-full',\r\n\t\tvariants: {\r\n\t\t\tvariant: {\r\n\t\t\t\tdefault: 'bg-primary text-primary',\r\n\t\t\t\tsuccess: 'bg-emerald-500 text-emerald-500',\r\n\t\t\t\twarning: 'bg-amber-500 text-amber-500',\r\n\t\t\t\terror: 'bg-rose-500 text-rose-500',\r\n\t\t\t\tinfo: 'bg-sky-500 text-sky-500',\r\n\t\t\t\tmuted: 'bg-muted-foreground/50 text-muted-foreground/50'\r\n\t\t\t},\r\n\t\t\tsize: {\r\n\t\t\t\tsm: 'h-2 w-2',\r\n\t\t\t\tmd: 'h-3 w-3',\r\n\t\t\t\tlg: 'h-4 w-4'\r\n\t\t\t}\r\n\t\t},\r\n\t\tdefaultVariants: {\r\n\t\t\tvariant: 'default',\r\n\t\t\tsize: 'md'\r\n\t\t}\r\n\t});\r\n\r\n\ttype Variant = VariantProps<typeof dotVariants>['variant'];\r\n\ttype Size = VariantProps<typeof dotVariants>['size'];\r\n\r\n\tlet {\r\n\t\tclass: className,\r\n\t\tvariant = 'default',\r\n\t\tsize = 'md',\r\n\t\tpulse = false,\r\n\t\t...rest\r\n\t}: {\r\n\t\tclass?: string;\r\n\t\tvariant?: Variant;\r\n\t\tsize?: Size;\r\n\t\tpulse?: boolean;\r\n\t\t[key: string]: any;\r\n\t} = $props();\r\n</script>\r\n\r\n<span\r\n\tclass={cn('relative flex items-center justify-center', dotVariants({ size }), className)}\r\n\t{...rest}\r\n>\r\n\t{#if pulse}\r\n\t\t<span\r\n\t\t\tclass={cn(\r\n\t\t\t\t'absolute inline-flex h-full w-full animate-ping rounded-full opacity-75',\r\n\t\t\t\tdotVariants({ variant, size: undefined })\r\n\t\t\t)}\r\n\t\t></span>\r\n\t{/if}\r\n\t<span class={cn('relative inline-flex rounded-full', dotVariants({ variant, size }))}></span>\r\n</span>\r\n",
			"type": "registry:ui",
			"target": "status-dot/status-dot.svelte"
		},
		{
			"content": "import StatusDot from \"./status-dot.svelte\";\r\n\r\nexport { StatusDot as Root };",
			"type": "registry:ui",
			"target": "status-dot/index.ts"
		}
	]
}