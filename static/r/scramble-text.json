			"content": "import ScrambleText, { SCRAMBLE_CHARACTERS, type ScrambleReveal } from './scramble-text.svelte';\n\nexport { ScrambleText, ScrambleText as Root, SCRAMBLE_CHARACTERS, type ScrambleReveal };\n",
			"type": "registry:ui",
			"target": "scramble-text/index.ts"
		}
